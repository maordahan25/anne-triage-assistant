# תבנית משתני סביבה ל-"אן" — שלב הסוכנים.
# העתק לקובץ .env ומלא את המפתחות. אל תכניס סודות אמיתיים לקובץ זה.
#   cp .env.example .env

# ── ספק ה-LLM ───────────────────────────────────────────────────────────
# openai  או  anthropic — מאפשר החלפה קלה בין הספקים ללא שינוי קוד.
LLM_PROVIDER=openai

# ── מפתחות API (לפי הספק שנבחר ב-LLM_PROVIDER) ───────────────────────────
OPENAI_API_KEY= 
ANTHROPIC_API_KEY=

# ── עקיפת שמות מודלים (אופציונלי) ────────────────────────────────────────
# ברירות המחדל מוגדרות ב-llm/config.py. הגדר כאן רק כדי לעקוף.
# שלוש דרגות: strong (חזק) / medium (בינוני) / economical (חסכוני).
#
# OpenAI:
# OPENAI_MODEL_STRONG=gpt-4o
# OPENAI_MODEL_MEDIUM=gpt-4o-mini
# OPENAI_MODEL_ECONOMICAL=gpt-4o-mini
#
# Anthropic (קידומת anthropic/; דורש התקנת crewai[anthropic]):
# ANTHROPIC_MODEL_STRONG=anthropic/claude-opus-4-8
# ANTHROPIC_MODEL_MEDIUM=anthropic/claude-sonnet-4-6
# ANTHROPIC_MODEL_ECONOMICAL=anthropic/claude-haiku-4-5

# ── סוכנים (שלב ב') — אופציונלי ─────────────────────────────────────────
# לוגים מפורטים של הסוכנים וה-crew בזמן שיחה (ברירת מחדל: כבוי).
# ANNE_VERBOSE=1

# טלמטריית crewai כבויה כברירת מחדל בקוד (פרטיות by design, שקף 18).
# להפעלתה מחדש בכל זאת:
# CREWAI_DISABLE_TELEMETRY=false

# ── אזור המנהל (/admin) — שער הדגמה זמני ────────────────────────────────
# משתמש יחיד. אין ברירת מחדל בקוד: בלי שני המשתנים האלה אין התחברות
# בכלל, והמסך מציג "לא הוגדרו פרטי כניסה". כאן מציין-מיקום בלבד —
# הערכים האמיתיים יושבים ב-.env המקומי, שאינו עולה ל-Git.
ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-admin-password
