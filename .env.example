# תבנית משתני סביבה ל-"אן" — שלב הסוכנים.
# העתק לקובץ .env ומלא את המפתחות. אל תכניס סודות אמיתיים לקובץ זה.
#   cp .env.example .env

# ── ספק ה-LLM ───────────────────────────────────────────────────────────
# openai  או  anthropic — מאפשר החלפה קלה בין הספקים ללא שינוי קוד.
LLM_PROVIDER=openai

# ── מפתחות API (לפי הספק שנבחר ב-LLM_PROVIDER) ───────────────────────────
OPENAI_API_KEY= 
ANTHROPIC_API_KEY=

# ── עקיפת שמות מודלים (אופציונלי) ────────────────────────────────────────
# ברירות המחדל מוגדרות ב-llm/config.py. הגדר כאן רק כדי לעקוף.
# שלוש דרגות: strong (חזק) / medium (בינוני) / economical (חסכוני).
#
# OpenAI:
# OPENAI_MODEL_STRONG=gpt-4o
# OPENAI_MODEL_MEDIUM=gpt-4o-mini
# OPENAI_MODEL_ECONOMICAL=gpt-4o-mini
#
# Anthropic (קידומת anthropic/; דורש התקנת crewai[anthropic]):
# ANTHROPIC_MODEL_STRONG=anthropic/claude-opus-4-8
# ANTHROPIC_MODEL_MEDIUM=anthropic/claude-sonnet-4-6
# ANTHROPIC_MODEL_ECONOMICAL=anthropic/claude-haiku-4-5

# ── סוכנים (שלב ב') — אופציונלי ─────────────────────────────────────────
# לוגים מפורטים של הסוכנים וה-crew בזמן שיחה (ברירת מחדל: כבוי).
# ANNE_VERBOSE=1

# טלמטריית crewai כבויה כברירת מחדל בקוד (פרטיות by design, שקף 18).
# להפעלתה מחדש בכל זאת:
# CREWAI_DISABLE_TELEMETRY=false

# ── לוג השיחות: SQLite מקומי או Supabase (Postgres) ─────────────────────
# ANNE_LOG_BACKEND — sqlite (ברירת המחדל) או supabase. אין צורך בשינוי קוד:
# הממשק זהה בשניהם, והמתג יושב מתחתיו (storage/backend.py). הגדרות חסרות
# או חיבור שנכשל אינם מפילים את הצ'אט — הלוג חוזר ל-SQLite עם אזהרה בלוג.
ANNE_LOG_BACKEND=sqlite
# הטבלה כשלא נמסר יעד מפורש: turns (הלוג החי) או turns_synthetic (דאטה
# סינתטי). המתג "חי / סינתטי" בדשבורד מחליף בין השתיים — אותו חיבור.
ANNE_LOG_TABLE=turns
# זהות הפרויקט ב-Supabase (Settings -> API). נשמרות כאן לשלמות ולשלבים
# הבאים (ניהול משתמשים); שכבת הלוג עצמה מתחברת ישירות ב-Postgres ולכן
# אינה משתמשת בהן.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# מחרוזת החיבור ל-Postgres (Supabase -> Connect). ברירת המחדל היא החיבור
# הישיר, פורט 5432. הקוד מבצע URL-encoding לסיסמה, כך שתווים מיוחדים
# (@ / : # ורווח) אינם שוברים אותה — אין צורך לקודד ידנית.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# אופציונלי: מחרוזת ה-Transaction pooler (פורט 6543). אם הישיר נכשל,
# הקוד ינסה אותה אוטומטית. להחלפה קבועה — פשוט הדביקו אותה ב-
# SUPABASE_DB_URL למעלה (ראו README).
# SUPABASE_DB_URL_POOLER=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# ── אזור המנהל (/admin) — בקרת גישה ─────────────────────────────────────
# בקרת גישה לאזור המנהל מבוססת משתמש מנהל יחיד, שפרטיו נשמרים ב-.env
# מחוץ לבקרת גרסאות. זו החלטה מכוונת המתאימה להיקף המערכת — משתמש אחד
# בפועל, ולכן אין צורך בשכבת ניהול משתמשים.
# אין ברירת מחדל בקוד: בלי שני המשתנים האלה אין התחברות בכלל, והמסך מציג
# "לא הוגדרו פרטי כניסה". כאן מציין-מיקום בלבד — הערכים האמיתיים יושבים
# ב-.env המקומי, שאינו עולה ל-Git.
ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-admin-password

# ── אפליקציות ה-Streamlit — שער הפעולות המנהליות ─────────────────────────
# הפעולות המנהליות בשתי האפליקציות (איפוס הלוג בדשבורד, אימון המודלים
# בעמוד החיזוי) נעולות כברירת מחדל. בלי הקוד הזה הן **אינן קיימות בממשק**
# — לא כפתור ולא הכרטיס שעוטף אותו.
# זה מה שמאפשר לפרוס את האפליקציות כאפליקציות ציבוריות: הקובץ הזה אינו
# בבקרת גרסאות, ולכן הקוד פשוט אינו קיים בקונטיינר הציבורי.
# לפחות 8 תווים (קוד קצר מזה נחשב תקלת הגדרה ומשאיר את הפעולות חסומות).
# אל תזינו את המשתנה הזה בסודות של פריסה ציבורית — ראו ANNE_PUBLIC_DEPLOY.
# ANNE_DASHBOARD_ADMIN_CODE=your-local-admin-code

# הצהרה שזו פריסה ציבורית. כשהוא דלוק הפעולות המנהליות חסומות **גם אם**
# הוגדר קוד — חגורה שיכולה רק לסגור. מומלץ להדליק אותו בסודות של כל פריסה
# ציבורית (ב-Streamlit Cloud פריסה מזוהה גם אוטומטית לפי נתיב ההרצה).
# ANNE_PUBLIC_DEPLOY=1
