# סודות וסביבה — לעולם לא בבקרת גרסאות
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Vector DB (נוצר אוטומטית ע"י build_index.py)
chroma_db/

# לוג השיחות האנונימי (SQLite) — נוצר בזמן ריצה (כולל הקובץ הסינתטי)
anne_log*.db

# תוצרי אימון מודל החיזוי — נבנים מחדש עם python -m ml.train.
# חריג אחד: ה-bundle הראשי כן נמצא בבקרת גרסאות, כדי שעמוד החיזוי יעבוד
# בפריסת Streamlit Cloud — שם אין נתוני אימון (קובצי ה-SQLite מוחרגים) וגם
# אין כפתור אימון (הפעולה חסומה בפריסה ציבורית). ~600KB.
# התבנית היא ml/models/* ולא ml/models/, כי git אינו מאפשר להחזיר קובץ
# שתיקיית האם שלו מוחרגת — החרגת *תוכן* התיקייה היא מה שמאפשר את ה-!.
ml/models/*
!ml/models/er_referral.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# מטמון מודלים / HuggingFace
.cache/

# הגדרות מקומיות של Claude Code (הרשאות למכונה הזו, לא תוצר של הפרויקט)
.claude/settings.local.json*

# מערכת הפעלה / עורך
.DS_Store
.idea/
.vscode/
